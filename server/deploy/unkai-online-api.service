[Unit]
Description=Unkai Arkham online API additions
After=network-online.target arkham-horror-public-v2.service
Wants=network-online.target

[Service]
Type=simple
User=arkham
Group=arkham
WorkingDirectory=/opt/arkham-horror-public-v2/online-api
EnvironmentFile=/etc/unkai-arkham-online-api.env
ExecStart=/opt/arkham-horror-public-v2/online-api/venv/bin/python /opt/arkham-horror-public-v2/online-api/online_api.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/arkham-horror-public-v2

[Install]
WantedBy=multi-user.target
